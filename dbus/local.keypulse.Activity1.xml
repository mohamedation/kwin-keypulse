<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Privacy contract for kwin-keypulse:

  KeyActivity carries no key codes, keysyms, text, modifiers, window
  titles, or device identifiers. The KWin plugin must drop key identity before
  emitting this signal.

  The plugin owns the bus name and emits; any number of consumers may subscribe.
-->
<node name="/local/keypulse/Emitter">
  <interface name="local.keypulse.Activity1">
    <signal name="KeyActivity"/>
  </interface>
</node>
