<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Privacy contract for kwin-keypulse:

  NotifyKeyActivity carries no key codes, keysyms, text, modifiers, window
  titles, or device identifiers. The KWin plugin must drop key identity before
  calling this method.

  Consumers (keyboard-sound apps, etc.) own the bus name and implement this
  method. The plugin only fire-and-forgets the call.
-->
<node name="/local/keypulse/Player">
  <interface name="local.keypulse.Activity1">
    <method name="NotifyKeyActivity"/>
  </interface>
</node>
